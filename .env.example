# Redpanda & Kafka Broker Configuration
REDPANDA_BROKERS=localhost:19092
REDPANDA_TOPIC_RAW=edge-iiot-raw
REDPANDA_TOPIC_PREPROCESSED=edge-iiot-preprocessed
REDPANDA_TOPIC_PREDICTIONS=ids-predictions
REDPANDA_TOPIC_ALERTS=ids-alerts
REDPANDA_TOPIC_METRICS=ids-metrics
REDPANDA_TOPIC_DEAD_LETTER=ids-dead-letter
